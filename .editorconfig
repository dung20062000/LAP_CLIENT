# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs.
root = true

# ==========================================
# GLOBAL RULES
# ==========================================
[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

# ==========================================
# C# / .NET 8 RULES
# ==========================================
[*.cs]
indent_style = space
indent_size = 4
max_line_length = 120

# Naming Conventions
dotnet_naming_rule.interface_should_be_begun_with_i.severity = error
dotnet_naming_rule.interface_should_be_begun_with_i.symbols = interface_symbols
dotnet_naming_rule.interface_should_be_begun_with_i.style = begun_with_i_style

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.begun_with_i_style.required_prefix = I
dotnet_naming_style.begun_with_i_style.capitalization = pascal_case

# Private Fields: _camelCase
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.severity = error
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.symbols = private_fields_symbols
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.style = underscore_camel_case_style

dotnet_naming_symbols.private_fields_symbols.applicable_kinds = field
dotnet_naming_symbols.private_fields_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case_style.required_prefix = _
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case

# Classes, Methods, Properties: PascalCase
dotnet_naming_rule.types_and_methods_should_be_pascal_case.severity = error
dotnet_naming_rule.types_and_methods_should_be_pascal_case.symbols = types_and_methods_symbols
dotnet_naming_rule.types_and_methods_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.types_and_methods_symbols.applicable_kinds = class, struct, method, property, delegate, enum
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Code Styles
csharp_new_line_before_open_brace = all
csharp_style_expression_bodied_methods = false
csharp_prefer_braces = true
csharp_preserve_single_line_blocks = false
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_semicolon_in_for_statement = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false

# ==========================================
# TypeScript / Angular RULES
# ==========================================
[*.{ts,tsx}]
indent_style = space
indent_size = 2
max_line_length = 120

# TypeScript keywords: lowercase
typescript_prefer_keyword = false

[*.html]
indent_style = space
indent_size = 2

[*.scss]
indent_style = space
indent_size = 2

# ==========================================
# SQL RULES
# ==========================================
[*.sql]
indent_style = space
indent_size = 2
sql_upper_case_keywords = true
max_line_length = 120

# ==========================================
# Markdown
# ==========================================
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# ==========================================
# JSON / YAML / Config
# ==========================================
[*.{json,yaml,yml}]
indent_style = space
indent_size = 2
