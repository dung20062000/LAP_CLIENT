{
  "eslint.validate": [
    "html",
    "typescript"
  ],
  "eslint.format.enable": true,
  "html.format.enable": false,
  "[html]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    }
  },
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    }
  },
  "editor.formatOnSave": false
}